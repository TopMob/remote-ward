# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicit text files
*.rs text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.jsx text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.webp binary
*.dll binary
*.exe binary
*.lib binary
*.sys binary
*.cat binary
*.cer binary
*.pfx binary
*.woff binary
*.woff2 binary
